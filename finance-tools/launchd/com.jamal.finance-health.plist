<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jamal.finance-health</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/jamal/miniconda3/bin/python3</string>
        <string>/Users/jamal/projects/myagents/finance-tools/weekly_health.py</string>
        <string>--email</string>
        <string>--weekly-guard</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/jamal/projects/myagents/finance-tools</string>
    <!-- Fires DAILY at 08:00 and at login; the script's weekly guard sends at most
         once per 6 days. launchd drops a calendar trigger missed while powered
         off (it only catches up after sleep), so a daily trigger + guard makes
         a Monday power-off self-heal on the next morning the Mac is on. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/jamal/Library/Logs/finance-health.log</string>
    <key>StandardErrPath</key>
    <string>/Users/jamal/Library/Logs/finance-health.log</string>
</dict>
</plist>
