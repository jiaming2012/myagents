ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_CALENDAR_ID=
MONARCH_TOKEN=
MERCURY_BUSINESS_API_KEY=
MERCURY_PERSONAL_API_KEY=

# Gmail SMTP (requires App Password — see https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL=
# Optional Monarch login helpers (see monarch_client.py)
# Device-Uuid your browser sends (DevTools -> any api.monarch.com request -> Request Headers)
# so Monarch treats the script as an already-trusted device and skips the email code:
MONARCH_DEVICE_UUID=
# Setup key from Monarch Settings -> Security -> Enable MFA; makes the login non-interactive:
MONARCH_MFA_SECRET=
# Only if Monarch ever rejects the client version (copy Monarch-Client-Version from DevTools):
MONARCH_CLIENT_VERSION=
