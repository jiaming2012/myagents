# Notion internal-integration token.
# Create at https://www.notion.so/my-integrations and share the workspace
# (or specific pages/DBs) with the integration so it can read them.
NOTION_API_TOKEN=secret_...

# Used by the Todoist completion bridge + apply.
# Already set by other tools in this repo; document here for completeness.
TODOIST_API_TOKEN=...

# Optional. How many days back to scan for newly-tagged objects.
NOTION_LOOKBACK_DAYS=14
