# Google account whose My Drive is migrated (also names the state/ and archive folders)
GOOGLE_ACCOUNT=jamal@yumyums.kitchen

# Google OAuth desktop client. Leave unset to reuse GMAIL_CLIENT_ID/GMAIL_CLIENT_SECRET
# from ../email-tools/.env (the Drive API must be enabled on that Google Cloud project).
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=

# Zoho Self Client. Leave unset to reuse ZOHO_CLIENT_ID/ZOHO_CLIENT_SECRET from ../finance-tools/.env.
#ZOHO_CLIENT_ID=
#ZOHO_CLIENT_SECRET=

# Written by `task drive:auth:zoho -- <grant code>`
#ZOHO_WORKDRIVE_REFRESH_TOKEN=

# WorkDrive folder that becomes the root of the migrated tree (id at the end of its URL)
#WORKDRIVE_DEST_FOLDER_ID=

# Local copy of the Drive; keep it after the migration as the backup. Default ~/Drive-Archive/<account>
#ARCHIVE_DIR=
